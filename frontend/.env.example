# Frontend settings. Copy to .env and adjust. Values starting with VITE_ are built into the app,
# so run `npm run build` again after changing them.

# Where the app calls the API. Keep "/api" when nginx (production) or the dev server forwards
# /api to the backend on the same domain. Only change it to call an API on another domain.
VITE_API_URL=/api

# --- Dev server only (npm run dev) ---
# The backend it forwards /api to: http://127.0.0.1:<PORT from backend/.env>
API_TARGET=http://127.0.0.1:5000
# Address and port of the dev server ("::" = all addresses, so it opens by LAN IP too).
DEV_HOST=::
DEV_PORT=8080
