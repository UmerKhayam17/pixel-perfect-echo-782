PORT=5000
# Network interface to listen on. Empty = this computer only; 0.0.0.0 = your whole network.
HOST=
MONGODB_URI=mongodb://127.0.0.1:27017/leadfinder
# Comma-separated list of allowed frontend origins ("*" allows any)
CORS_ORIGIN=http://localhost:8080

# Optional: when set, searches use the official Google Places API instead of scraping Google Maps.
GOOGLE_PLACES_API_KEY=

# Optional: python interpreter for the scraper. Defaults to scraper/.venv if it exists, else "python".
PYTHON_BIN=
# Set to "false" to watch the Google Maps browser while it scrapes.
SCRAPER_HEADLESS=true

# Security
# Secret used to encrypt saved SMTP passwords and API keys. If empty, a key is generated in
# backend/.app-secret on first start — back that file up.
APP_SECRET=
# "true" when served over HTTPS. Use COOKIE_SAMESITE=none (with HTTPS) if the frontend and API
# are on different domains.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# How long "Keep me signed in" lasts.
SESSION_DAYS=30

# Admin account — created automatically on startup if this email has no account yet.
# It never overwrites an existing account. You'll be asked to choose a new password at first
# sign-in; after that, remove ADMIN_PASSWORD from this file. Staff are added in the app (Team).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backups: one per day of the whole database, kept for BACKUP_KEEP_DAYS days.
# Restore with: npm run restore
BACKUP_ENABLED=true
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# How long the staff activity log keeps entries.
AUDIT_RETENTION_DAYS=180
